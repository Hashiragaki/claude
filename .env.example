# Copiez ce fichier en .env puis renseignez votre clé pour activer l'IA (assistant + génération par Claude).
# Sans clé, Forge fonctionne en mode procédural et l'assistant comprend les commandes hors-ligne (/aide).
ANTHROPIC_API_KEY=

# Modèle Claude utilisé (par défaut : claude-opus-5).
# FORGE_MODEL=claude-opus-5

# Niveau d'effort du modèle : low | medium | high | xhigh | max (par défaut : celui du modèle).
# FORGE_EFFORT=high

# Repli automatique vers un autre modèle si une demande est refusée (on | off, défaut : on).
# FORGE_REFUSAL_FALLBACK=on

# IA : auto (activée si une clé est présente), on, off.
# FORGE_AI=auto

# Dossier des projets (défaut : ./workspace) et port du serveur (défaut : 8787).
# FORGE_DATA_DIR=./workspace
# PORT=8787

# Nombre de générations d'assets simultanées (défaut : 2).
# FORGE_JOB_CONCURRENCY=2
